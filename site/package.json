{
  "name": "gomap-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs ../scripts/compose-pages.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.5"
  },
  "devDependencies": { "@playwright/test": "1.64.1" }
}
